// ─────────────────────────────────────────────────────────
// Prisma Schema — Self KeyAuth
// Database: PostgreSQL (Vercel Postgres / Supabase)
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────────────────
// Users — Admin accounts that manage licenses
// ─────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys     Key[]
  logs     Log[]
  projects Project[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────
// Projects — Isolate keys by project, each with own secret
// ─────────────────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL slug for public portal page (/p/[slug])
  secret      String   @unique // API secret for validation
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Portal settings
  portalEnabled          Boolean @default(true)   // Enable public user portal
  loaderUrl              String?                   // Loader download URL
  requireHwidForDownload Boolean @default(true)    // Require HWID binding to download loader
  dashboardConfig        String? // JSON — portal dashboard layout config (blocks, buttons, etc.)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  keys         Key[]
  portalUsers  PortalUser[]
  chatMessages ChatMessage[]

  // Branding
  logoData     String?  // Base64-encoded PNG logo (data URI)

  // Secure DLL payload — encrypted at rest in Vercel Blob (private)
  dllBlobUrl    String?  // Private Blob URL for AES-256-GCM encrypted DLL
  dllData       String?  // Legacy: AES-256-GCM encrypted DLL in DB (base64)
  dllHash       String?  // SHA-256 hash of original DLL for integrity check
  dllUploadedAt DateTime? // When the DLL was last uploaded

  @@index([ownerId])
  @@index([secret])
  @@index([slug])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────
// License Keys — Core licensing entity
// ─────────────────────────────────────────────────────────
model Key {
  id          String    @id @default(cuid())
  key         String    @unique // The actual license key (encrypted)
  mask        String    // Visible prefix for UI display (e.g., XXXX-****-****)
  plan        Plan      @default(DAILY)
  status      KeyStatus @default(ACTIVE)
  hwid        String?   // Hardware ID lock (motherboard UUID + disk serial hash)
  hwidLocked  Boolean   @default(false)
  maxSessions Int       @default(1)
  activeSessions Int    @default(0)

  // Server-side variables (anti memory-patch)
  serverVar   String?   // Encrypted variable sent only on valid auth
  serverNonce String?   // One-time nonce rotated per validation

  customDays  Int?      // Custom expiry duration in days (for CUSTOM plan)
  note        String?   // Admin note / label for the key

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  logs       Log[]
  portalUser PortalUser?

  @@index([key])
  @@index([hwid])
  @@index([status, expiresAt])
  @@index([projectId])
  @@map("keys")
}

// ─────────────────────────────────────────────────────────
// Audit Logs — Every action is logged
// ─────────────────────────────────────────────────────────
model Log {
  id        String   @id @default(cuid())
  action    String   // e.g., "validate", "login", "key_create", "hwid_reset"
  ip        String?
  userAgent String?
  hwid      String?
  payload   String?  // Encrypted JSON blob
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  keyId  String?
  key    Key?    @relation(fields: [keyId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([keyId])
  @@map("logs")
}

// ─────────────────────────────────────────────────────────
// Rate Limit Buckets — Persisted rate limiting
// ─────────────────────────────────────────────────────────
model RateLimit {
  id         String   @id @default(cuid())
  identifier String   @unique // IP or API key hash
  tokens     Int      @default(10)
  lastRefill DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@map("rate_limits")
}

// ─────────────────────────────────────────────────────────
// Portal Users — End-users of a project (key holders)
// They register on /p/[slug] and can activate a license key
// ─────────────────────────────────────────────────────────
model PortalUser {
  id        String   @id @default(cuid())
  username  String
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  keyId String? @unique
  key   Key?    @relation(fields: [keyId], references: [id], onDelete: SetNull)

  chatMessages ChatMessage[]

  @@unique([username, projectId])
  @@index([projectId])
  @@map("portal_users")
}

// ─────────────────────────────────────────────────────────
// Chat Messages — In-project chat between portal users
// ─────────────────────────────────────────────────────────
model ChatMessage {
  id        String   @id @default(cuid())
  text      String   // Message content (max ~2000 chars enforced in API)
  createdAt DateTime @default(now())

  authorId  String
  author    PortalUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([authorId])
  @@map("chat_messages")
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────
enum Role {
  ADMIN
  VIEWER
}

enum Plan {
  DAILY
  WEEKLY
  MONTHLY
  LIFETIME
  CUSTOM
}

enum KeyStatus {
  ACTIVE
  EXPIRED
  BANNED
  REVOKED
}
